# Market data for recommendations (mainnet; public, no key needed).
# STELLAR_EXPERT_API_URL=https://api.stellar.expert/explorer/public
# MARKET_HORIZON_URL=https://horizon.stellar.org

# -- Stellar ------------------------------------------------------------------
# mainnet | testnet
NEXT_PUBLIC_STELLAR_NETWORK=mainnet
# Optional overrides; defaults follow the network above.
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# NEXT_PUBLIC_USDC_ASSET=USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# true = sandbox positions, nothing is signed or broadcast.
NEXT_PUBLIC_DRY_RUN=false
FIXED_SLIPPAGE_BPS=75
MIN_LIVE_TRADE_USDC=1
TX_TIMEOUT_SECONDS=180

# -- Commission ---------------------------------------------------------------
# Stellar account (G...) that receives the 2% entry fee. It must hold a USDC
# trustline before the first live trade. Leave empty to disable the fee.
TREASURY_WALLET=
